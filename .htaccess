# Karma Doctors & Associates - Apache Configuration & Rewrite Rules

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ------------------------------------------------------------------
    # Legacy WordPress URLs -> 301 to the new canonical URL.
    # The old site published everything with a trailing slash and Google
    # still has those indexed, so each old shape is redirected exactly once.
    # These must stay ABOVE the internal routing rules below.
    # ------------------------------------------------------------------

    # Old blog index: /blogs/ and /blogs/page/2/
    RewriteRule ^blogs/page/([0-9]+)/?$ /blog?paged=$1 [R=301,L]
    RewriteRule ^blogs/?$ /blog [R=301,L]

    # WordPress category/tag archives have no equivalent -> blog index
    RewriteRule ^(?:category|tag)/[^/]+/?$ /blog [R=301,L]

    # Old service URLs: /services/depression/ -> /depression
    RewriteRule ^services?/(adhd|anxiety|depression|ocd|ptsd|medication-management)/?$ /$1 [R=301,L]
    RewriteRule ^services?/tms(?:-therapy)?/?$ /tms [R=301,L]
    RewriteRule ^contact-us/?$ /contact [R=301,L]

    # Pages renamed in the move off WordPress
    RewriteRule ^about-us/?$ /about [R=301,L]
    RewriteRule ^providers/?$ /about [R=301,L]
    RewriteRule ^content/client-forms/?$ /client-forms [R=301,L]
    RewriteRule ^conditions/?$ /patient-education [R=301,L]

    # WordPress author archives and feeds have no equivalent -> blog index
    RewriteRule ^author/[^/]+/?$ /blog [R=301,L]
    RewriteRule ^(?:comments/)?feed/?$ /blog [R=301,L]

    # Service hub, and services with no dedicated page on the new site
    RewriteRule ^services?/?$ /tms [R=301,L]
    RewriteRule ^services?/mood-disorders/?$ /bipolar [R=301,L]
    RewriteRule ^services?/schizophrenia/?$ /what-are-the-5-causes-of-schizophrenia [R=301,L]

    # Articles whose slug changed during the migration
    RewriteRule ^is-anxiety-a-disability/?$ /is-anxiety-a-disability-the-legal-and-medical-truth [R=301,L]
    RewriteRule ^tms-helping-veterans-address-mental-health-challenges/?$ /how-tms-is-helping-veterans-address-mental-health-challenges [R=301,L]
    RewriteRule ^mental-health-role-of-psychiatrists/?$ /understanding-your-mental-health-the-vital-role-of-psychiatrists [R=301,L]
    RewriteRule ^culturally-responsive-care-for-diverse-mental-health/?$ /embracing-diversity-in-mental-health-care-culturally-responsive-psychiatry [R=301,L]
    RewriteRule ^what-is-major-depressive-disorder/?$ /depression [R=301,L]

    # Old /post/<slug>/ permalinks -> the article if it still exists, else the index
    RewriteCond %{DOCUMENT_ROOT}/includes/blog-posts/$1.php -f
    RewriteRule ^post/([a-z0-9\-]+)/?$ /$1 [R=301,L]
    RewriteRule ^post/[a-z0-9\-]+/?$ /blog [R=301,L]

    # Articles live at the site root (the WordPress permalink shape).
    # /blog/<slug> was used briefly during the rebuild -> send it to the root.
    RewriteRule ^blog/([a-z0-9\-]+)/?$ /$1 [R=301,L]

    # Canonical article URL has no trailing slash: /<slug>/ -> /<slug>
    RewriteCond %{DOCUMENT_ROOT}/includes/blog-posts/$1.php -f
    RewriteRule ^([a-z0-9\-]+)/+$ /$1 [R=301,L]

    # Trailing slash on a real page: /tms/ -> /tms
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^(.+?)/+$ /$1 [R=301,L]


    # Route /psychiatrist-near-slug to areas-we-serve/location-psychiatrist-near-slug.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^psychiatrist-near-([a-z0-9\-]+)/?$ areas-we-serve/location-psychiatrist-near-$1.php [L,QSA]

    # /areas-we-serve must reach areas-we-serve.php.
    # The generic extensionless rule below is gated on !-d, and a directory named
    # areas-we-serve/ exists (it holds the location pages), so that rule skips this
    # URL. Handle it explicitly, before the generic rule.
    RewriteRule ^areas-we-serve/?$ areas-we-serve.php [L,QSA]

    # Route extensionless URL to PHP file if file exists (e.g. /about -> about.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([^\.]+)$ $1.php [NC,L]

    # Serve articles from the site root: /<slug> -> single-blog.php?slug=<slug>.
    # Placed after the page rule above, so a real page always wins a name clash.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/includes/blog-posts/$1.php -f
    RewriteRule ^([a-z0-9\-]+)$ single-blog.php?slug=$1 [L,QSA]

    # Route directory requests to index.php
    DirectoryIndex index.php
</IfModule>

# Fallback 404
ErrorDocument 404 /404.php

# Caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
