    RewriteRule ^does-ocd-go-away-without-treatment/$ /does-ocd-go-away-without-treatment [R=301,L]
    RewriteRule ^does-psychiatric-treatment-work-evidence-success-rates-real-results/$ /does-psychiatric-treatment-work-evidence-success-rates-real-results [R=301,L]
    RewriteRule ^does-tms-make-you-tired/$ /does-tms-make-you-tired [R=301,L]
    RewriteRule ^does-tms-therapy-hurt/$ /does-tms-therapy-hurt [R=301,L]
    RewriteRule ^does-tricare-cover-tms-therapy-everything-you-need-to-know/$ /does-tricare-cover-tms-therapy-everything-you-need-to-know [R=301,L]
    RewriteRule ^embracing-diversity-in-mental-health-care-culturally-responsive-psychiatry/$ /embracing-diversity-in-mental-health-care-culturally-responsive-psychiatry [R=301,L]
    RewriteRule ^family-and-friends-in-mental-health-recovery/$ /family-and-friends-in-mental-health-recovery [R=301,L]
    RewriteRule ^feeling-weighed-down-by-depression-you-can-feel-better-heres-how/$ /feeling-weighed-down-by-depression-you-can-feel-better-heres-how [R=301,L]
    RewriteRule ^helping-a-loved-one-with-a-mood-disorder/$ /helping-a-loved-one-with-a-mood-disorder [R=301,L]
    RewriteRule ^how-can-i-get-tms-for-ocd/$ /how-can-i-get-tms-for-ocd [R=301,L]
    RewriteRule ^how-do-i-know-if-i-have-bipolar-disorder-early-warning-signs/$ /how-do-i-know-if-i-have-bipolar-disorder-early-warning-signs [R=301,L]
    RewriteRule ^how-do-psychiatrists-diagnose-adhd-in-adults/$ /how-do-psychiatrists-diagnose-adhd-in-adults [R=301,L]
    RewriteRule ^how-does-adhd-treatment-work/$ /how-does-adhd-treatment-work [R=301,L]
    RewriteRule ^how-effective-are-ptsd-treatments-for-veterans-evidence-based-results/$ /how-effective-are-ptsd-treatments-for-veterans-evidence-based-results [R=301,L]
    RewriteRule ^how-long-does-tms-therapy-last/$ /how-long-does-tms-therapy-last [R=301,L]
