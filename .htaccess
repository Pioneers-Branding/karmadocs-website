    RewriteRule ^what-are-the-side-effects-of-tms-things-you-must-know/$ /what-are-the-side-effects-of-tms-things-you-must-know [R=301,L]
    RewriteRule ^what-are-the-treatments-for-ptsd/$ /what-are-the-treatments-for-ptsd [R=301,L]
    RewriteRule ^what-are-tms-treatments/$ /what-are-tms-treatments [R=301,L]
    RewriteRule ^what-does-tms-therapy-help-with/$ /what-does-tms-therapy-help-with [R=301,L]
    RewriteRule ^what-is-deep-tms-therapy-process-benefits-treatment-overview/$ /what-is-deep-tms-therapy-process-benefits-treatment-overview [R=301,L]
    RewriteRule ^why-mental-health-awareness-month/$ /why-mental-health-awareness-month [R=301,L]
    RewriteRule ^why-some-patients-say-tms-ruined-my-life-a-psychiatrists-perspective/$ /why-some-patients-say-tms-ruined-my-life-a-psychiatrists-perspective [R=301,L]
    # --- Areas we serve (29) ---
    RewriteRule ^psychiatrist-near-banning/$ /psychiatrist-near-banning [R=301,L]
    RewriteRule ^psychiatrist-near-beaumont/$ /psychiatrist-near-beaumont [R=301,L]
    RewriteRule ^psychiatrist-near-calipatria/$ /psychiatrist-near-calipatria [R=301,L]
    RewriteRule ^psychiatrist-near-cathedral-city/$ /psychiatrist-near-cathedral-city [R=301,L]
    RewriteRule ^psychiatrist-near-coachella/$ /psychiatrist-near-coachella [R=301,L]
    RewriteRule ^psychiatrist-near-desert-hot-springs/$ /psychiatrist-near-desert-hot-springs [R=301,L]
    RewriteRule ^psychiatrist-near-desert-shores/$ /psychiatrist-near-desert-shores [R=301,L]
    RewriteRule ^psychiatrist-near-hemet/$ /psychiatrist-near-hemet [R=301,L]
    RewriteRule ^psychiatrist-near-indian-wells/$ /psychiatrist-near-indian-wells [R=301,L]
    RewriteRule ^psychiatrist-near-indio/$ /psychiatrist-near-indio [R=301,L]
    RewriteRule ^psychiatrist-near-la-quinta/$ /psychiatrist-near-la-quinta [R=301,L]
    RewriteRule ^psychiatrist-near-lake-elsinore/$ /psychiatrist-near-lake-elsinore [R=301,L]
    RewriteRule ^psychiatrist-near-mecca/$ /psychiatrist-near-mecca [R=301,L]
    RewriteRule ^psychiatrist-near-moreno-valley/$ /psychiatrist-near-moreno-valley [R=301,L]
    RewriteRule ^psychiatrist-near-murrieta/$ /psychiatrist-near-murrieta [R=301,L]
    RewriteRule ^psychiatrist-near-niland/$ /psychiatrist-near-niland [R=301,L]
    RewriteRule ^psychiatrist-near-palm-desert/$ /psychiatrist-near-palm-desert [R=301,L]
    RewriteRule ^psychiatrist-near-palm-springs/$ /psychiatrist-near-palm-springs [R=301,L]
    RewriteRule ^psychiatrist-near-palo-verde/$ /psychiatrist-near-palo-verde [R=301,L]
    RewriteRule ^psychiatrist-near-perris/$ /psychiatrist-near-perris [R=301,L]
    RewriteRule ^psychiatrist-near-rancho-mirage/$ /psychiatrist-near-rancho-mirage [R=301,L]
    RewriteRule ^psychiatrist-near-riverside/$ /psychiatrist-near-riverside [R=301,L]
    RewriteRule ^psychiatrist-near-salton-city/$ /psychiatrist-near-salton-city [R=301,L]
    RewriteRule ^psychiatrist-near-san-bernardino/$ /psychiatrist-near-san-bernardino [R=301,L]
    RewriteRule ^psychiatrist-near-san-jacinto/$ /psychiatrist-near-san-jacinto [R=301,L]
    RewriteRule ^psychiatrist-near-temecula/$ /psychiatrist-near-temecula [R=301,L]
    RewriteRule ^psychiatrist-near-thermal/$ /psychiatrist-near-thermal [R=301,L]
    RewriteRule ^psychiatrist-near-twentynine-palms/$ /psychiatrist-near-twentynine-palms [R=301,L]
    RewriteRule ^psychiatrist-near-yucca-valley/$ /psychiatrist-near-yucca-valley [R=301,L]
    # Catch-all for anything not listed above (and any page added later).
    # Gated on !-d so real directories (assets/) are left alone.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [R=301,L]

    # /areas-we-serve is a real page, but a directory of the same name exists, so the
    # rule above skips it. Strip the slash here so this URL matches the rest of the site.
    RewriteRule ^areas-we-serve/$ /areas-we-serve [R=301,L]


    # Route /psychiatrist-near-slug to areas-we-serve/location-psychiatrist-near-slug.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^psychiatrist-near-([a-z0-9\-]+)/?$ areas-we-serve/location-psychiatrist-near-$1.php [L,QSA]

    # /areas-we-serve must reach areas-we-serve.php.
    # The generic extensionless rule below is gated on !-d, and a directory named
    # areas-we-serve/ exists (it holds the location pages), so that rule skips this
    # URL. Handle it explicitly, before the generic rule.
    RewriteRule ^areas-we-serve/?$ areas-we-serve.php [L,QSA]

    # Route extensionless URL to PHP file if file exists (e.g. /about -> about.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([^\.]+)$ $1.php [NC,L]

    # Serve articles from the site root: /<slug> -> single-blog.php?slug=<slug>.
    # Placed after the page rule above, so a real page always wins a name clash.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/includes/blog-posts/$1.php -f
    RewriteRule ^([a-z0-9\-]+)$ single-blog.php?slug=$1 [L,QSA]

    # Route directory requests to index.php
    DirectoryIndex index.php

    # Apache would otherwise 301 /areas-we-serve to /areas-we-serve/ because the
    # directory exists, re-adding the slash we just removed. The rewrite rules above
    # answer both forms, so this automatic redirect is not needed.
    DirectorySlash Off
</IfModule>

# Never serve a directory listing
Options -Indexes

# Fallback 404
ErrorDocument 404 /404.php

# Caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
