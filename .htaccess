    RewriteRule ^how-much-does-a-psychiatrist-cost-a-complete-guide-to-mental-health-care/$ /how-much-does-a-psychiatrist-cost-a-complete-guide-to-mental-health-care [R=301,L]
    RewriteRule ^how-tms-helps-military-members-dependents/$ /how-tms-helps-military-members-dependents [R=301,L]
    RewriteRule ^how-tms-is-helping-veterans-address-mental-health-challenges/$ /how-tms-is-helping-veterans-address-mental-health-challenges [R=301,L]
    RewriteRule ^how-to-better-your-nutrition-for-mental-wellness-and-welcoming-dr-todd-born-nd-cns/$ /how-to-better-your-nutrition-for-mental-wellness-and-welcoming-dr-todd-born-nd-cns [R=301,L]
    RewriteRule ^how-to-calm-anxiety-proven-tips-that-actually-work/$ /how-to-calm-anxiety-proven-tips-that-actually-work [R=301,L]
    RewriteRule ^is-adhd-a-disability-what-you-need-to-know/$ /is-adhd-a-disability-what-you-need-to-know [R=301,L]
    RewriteRule ^is-anxiety-a-disability-the-legal-and-medical-truth/$ /is-anxiety-a-disability-the-legal-and-medical-truth [R=301,L]
    RewriteRule ^is-ptsd-a-disability/$ /is-ptsd-a-disability [R=301,L]
    RewriteRule ^is-tms-dip-normal/$ /is-tms-dip-normal [R=301,L]
    RewriteRule ^is-tms-therapy-covered-by-insurance-complete-guide-for/$ /is-tms-therapy-covered-by-insurance-complete-guide-for [R=301,L]
    RewriteRule ^is-tms-therapy-legitimate-a-2026-evidence-based-guide/$ /is-tms-therapy-legitimate-a-2026-evidence-based-guide [R=301,L]
    RewriteRule ^mental-health-palm-springs-ca-karmadocs/$ /mental-health-palm-springs-ca-karmadocs [R=301,L]
    RewriteRule ^physical-symptoms-of-anxiety-most-people-dont-recognize/$ /physical-symptoms-of-anxiety-most-people-dont-recognize [R=301,L]
    RewriteRule ^the-cost-of-tms-without-insurance-your-complete-guide/$ /the-cost-of-tms-without-insurance-your-complete-guide [R=301,L]
    RewriteRule ^the-effectiveness-of-tms-on-treatment-resistant-depression/$ /the-effectiveness-of-tms-on-treatment-resistant-depression [R=301,L]
    RewriteRule ^the-link-between-trauma-and-depression-understanding-the-connection/$ /the-link-between-trauma-and-depression-understanding-the-connection [R=301,L]
    RewriteRule ^the-pros-cons-of-tms-therapy/$ /the-pros-cons-of-tms-therapy [R=301,L]
    RewriteRule ^the-research-behind-mindfulness-for-mental-health-and-easy-ways-to-get-started-today/$ /the-research-behind-mindfulness-for-mental-health-and-easy-ways-to-get-started-today [R=301,L]
    RewriteRule ^the-unique-challenges-vets-face-and-5-ways-to-support-the-vets-in-your-life/$ /the-unique-challenges-vets-face-and-5-ways-to-support-the-vets-in-your-life [R=301,L]
    RewriteRule ^tms-cost-without-insurance-what-you-need-to-know-before-starting-treatment/$ /tms-cost-without-insurance-what-you-need-to-know-before-starting-treatment [R=301,L]
    RewriteRule ^tms-for-addiction-whats-the-4th-wave-of-the-opioid-epidemic-whats-the-4th-wave-of-the-opioid-epidemic-and-how-tms-can-help-with-addiction/$ /tms-for-addiction-whats-the-4th-wave-of-the-opioid-epidemic-whats-the-4th-wave-of-the-opioid-epidemic-and-how-tms-can-help-with-addiction [R=301,L]
    RewriteRule ^tms-therapy-near-me-that-accepts-medicaid/$ /tms-therapy-near-me-that-accepts-medicaid [R=301,L]
    RewriteRule ^top-10-psychiatrists-in-california-your-guide-to-trusted-mental-health-care/$ /top-10-psychiatrists-in-california-your-guide-to-trusted-mental-health-care [R=301,L]
    RewriteRule ^treatment-resistant-depression-when-medication-stops-working/$ /treatment-resistant-depression-when-medication-stops-working [R=301,L]
    RewriteRule ^understanding-your-mental-health-the-vital-role-of-psychiatrists/$ /understanding-your-mental-health-the-vital-role-of-psychiatrists [R=301,L]
