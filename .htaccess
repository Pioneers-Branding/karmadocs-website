# Karma Doctors & Associates - Apache Configuration & Rewrite Rules

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ------------------------------------------------------------------
    # Legacy WordPress URLs -> 301 to the new canonical URL.
    # The old site published everything with a trailing slash and Google
    # still has those indexed, so each old shape is redirected exactly once.
    # These must stay ABOVE the internal routing rules below.
    # ------------------------------------------------------------------

    # Old blog index: /blogs/ and /blogs/page/2/
    RewriteRule ^blogs/page/([0-9]+)/?$ /blog?paged=$1 [R=301,L]
    RewriteRule ^blogs/?$ /blog [R=301,L]

    # WordPress category/tag archives have no equivalent -> blog index
    RewriteRule ^(?:category|tag)/[^/]+/?$ /blog [R=301,L]

    # Old service URLs: /services/depression/ -> /depression
    RewriteRule ^services?/(adhd|anxiety|depression|ocd|ptsd|medication-management)/?$ /$1 [R=301,L]
    RewriteRule ^services?/tms(?:-therapy)?/?$ /tms [R=301,L]
    RewriteRule ^contact-us/?$ /contact [R=301,L]

    # Pages renamed in the move off WordPress
    RewriteRule ^about-us/?$ /about [R=301,L]
    RewriteRule ^providers/?$ /about [R=301,L]
    RewriteRule ^content/client-forms/?$ /client-forms [R=301,L]
    RewriteRule ^conditions/?$ /patient-education [R=301,L]

    # WordPress author archives and feeds have no equivalent -> blog index
    RewriteRule ^author/[^/]+/?$ /blog [R=301,L]
    RewriteRule ^(?:comments/)?feed/?$ /blog [R=301,L]

    # Service hub, and services with no dedicated page on the new site
    RewriteRule ^services?/?$ /tms [R=301,L]
    RewriteRule ^services?/mood-disorders/?$ /bipolar [R=301,L]
    RewriteRule ^services?/schizophrenia/?$ /what-are-the-5-causes-of-schizophrenia [R=301,L]

    # Articles whose slug changed during the migration
    RewriteRule ^is-anxiety-a-disability/?$ /is-anxiety-a-disability-the-legal-and-medical-truth [R=301,L]
    RewriteRule ^tms-helping-veterans-address-mental-health-challenges/?$ /how-tms-is-helping-veterans-address-mental-health-challenges [R=301,L]
    RewriteRule ^mental-health-role-of-psychiatrists/?$ /understanding-your-mental-health-the-vital-role-of-psychiatrists [R=301,L]
    RewriteRule ^culturally-responsive-care-for-diverse-mental-health/?$ /embracing-diversity-in-mental-health-care-culturally-responsive-psychiatry [R=301,L]
    RewriteRule ^what-is-major-depressive-disorder/?$ /depression [R=301,L]
    RewriteRule ^adhd-depression-comorbidity/?$ /unraveling-the-link-adhd-and-depression-comorbidity [R=301,L]
    RewriteRule ^benefits-of-therapy-for-anxiety/?$ /benefits-of-therapy-for-anxiety-how-professional-support-can-transform-mental-health [R=301,L]
    RewriteRule ^mental-health-palm-springs/?$ /mental-health-palm-springs-ca-karmadocs [R=301,L]

    # Old /post/<slug>/ permalinks -> the article if it still exists, else the index
    RewriteCond %{DOCUMENT_ROOT}/includes/blog-posts/$1.php -f
    RewriteRule ^post/([a-z0-9\-]+)/?$ /$1 [R=301,L]
    RewriteRule ^post/[a-z0-9\-]+/?$ /blog [R=301,L]

    # Articles live at the site root (the WordPress permalink shape).
    # /blog/<slug> was used briefly during the rebuild -> send it to the root.
    RewriteRule ^blog/([a-z0-9\-]+)/?$ /$1 [R=301,L]

    # ------------------------------------------------------------------
    # Global canonical rules. These run AFTER the specific legacy rules
    # above, so those still resolve in a single hop.
    # ------------------------------------------------------------------

    # Strip index.php out of any inbound URL: /index.php -> /
    RewriteCond %{THE_REQUEST} \s/+(.*?)index\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Strip a naked /index
    RewriteRule ^index/?$ / [R=301,L]

    # ==================================================================
    # Trailing slash -> no trailing slash, listed URL by URL.
    # WordPress published every page with a trailing slash; each old URL
    # below 301s to its canonical slash-free form.
    # The catch-all rule further down still covers anything not listed,
    # including pages added later.
    # ==================================================================

    # --- Site pages (21) ---
    RewriteRule ^about/$ /about [R=301,L]
    RewriteRule ^adhd/$ /adhd [R=301,L]
    RewriteRule ^anxiety/$ /anxiety [R=301,L]
    RewriteRule ^areas-we-serve/$ /areas-we-serve [R=301,L]
    RewriteRule ^bipolar/$ /bipolar [R=301,L]
    RewriteRule ^blog/$ /blog [R=301,L]
    RewriteRule ^client-forms/$ /client-forms [R=301,L]
    RewriteRule ^contact/$ /contact [R=301,L]
    RewriteRule ^depression/$ /depression [R=301,L]
    RewriteRule ^insurance-rates/$ /insurance-rates [R=301,L]
    RewriteRule ^karma-psychiatric-and-medicine-management/$ /karma-psychiatric-and-medicine-management [R=301,L]
    RewriteRule ^medication-management/$ /medication-management [R=301,L]
    RewriteRule ^ocd/$ /ocd [R=301,L]
    RewriteRule ^patient-education/$ /patient-education [R=301,L]
    RewriteRule ^privacy-policy/$ /privacy-policy [R=301,L]
    RewriteRule ^ptsd/$ /ptsd [R=301,L]
    RewriteRule ^research-publications/$ /research-publications [R=301,L]
    RewriteRule ^terms-conditions/$ /terms-conditions [R=301,L]
    RewriteRule ^thank-you/$ /thank-you [R=301,L]
    RewriteRule ^tms/$ /tms [R=301,L]
    RewriteRule ^tms-quiz/$ /tms-quiz [R=301,L]
    # --- Blog articles (66) ---
    RewriteRule ^9-digital-transformation-challenges-every-company-is-facing/$ /9-digital-transformation-challenges-every-company-is-facing [R=301,L]
    RewriteRule ^adhd-online-doctors/$ /adhd-online-doctors [R=301,L]
    RewriteRule ^adhd-treatment-online-can-it-work/$ /adhd-treatment-online-can-it-work [R=301,L]
    RewriteRule ^benefits-of-therapy-for-anxiety-how-professional-support-can-transform-mental-health/$ /benefits-of-therapy-for-anxiety-how-professional-support-can-transform-mental-health [R=301,L]
    RewriteRule ^benefits-of-tms-for-military-personnel-addressing-unique-challenges/$ /benefits-of-tms-for-military-personnel-addressing-unique-challenges [R=301,L]
    RewriteRule ^best-psychiatrist-california-how-to-find-expert-mental-health-care/$ /best-psychiatrist-california-how-to-find-expert-mental-health-care [R=301,L]
    RewriteRule ^bipolar-disorder-vs-mood-swings-whats-the-difference/$ /bipolar-disorder-vs-mood-swings-whats-the-difference [R=301,L]
